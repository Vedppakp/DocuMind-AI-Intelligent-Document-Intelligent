# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/documind_ai

# Security & Authentication (Change to a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Google Gemini API Key (Required for RAG embeddings and generative AI responses)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Email Service for Password Reset 6-Digit Code Delivery
# Option A: Gmail with App Password
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_gmail_app_password

# Option B: Custom SMTP Server
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM=no-reply@documind.ai
