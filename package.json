{
  "name": "documind-pdf-chatbot-rag",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
